{
  "name": "blurhash-url",
  "version": "1.4.1",
  "description": "Generate image URLs with embedded Blurhash placeholders.",
  "type": "module",
  "main": "./dist/blurhash-url.cjs",
  "module": "./dist/blurhash-url.js",
  "source": "./lib/blurhash-url.ts",
  "types": "./dist/blurhash-url.d.ts",
  "exports": {
    ".": {
      "types": "./dist/blurhash-url.d.ts",
      "import": "./dist/blurhash-url.js",
      "require": "./dist/blurhash-url.cjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs",
      "default": "./dist/constants.cjs"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc && vite build",
    "clean": "rimraf dist/",
    "dev": "vite",
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest --config test/config/vitest.config.ts",
    "test:browser": "pnpm run build && vitest run --config test/config/vitest.browser.config.ts",
    "test:ci": "vitest run --config test/config/vitest.config.ts",
    "test:package": "node test/package-smoke.mjs",
    "test:worker": "pnpm run build && vitest run --config test/config/vitest.worker.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionary-ux/blurhash-url.git"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "license": "ISC",
  "sideEffects": false,
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "visionary-base64url": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@eslint/js": "^9.39.2",
    "@types/node": "24.10.4",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "@vitest/browser-playwright": "4.1.8",
    "eslint": "9.39.2",
    "playwright": "1.62.1",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.8"
  },
  "keywords": [
    "base64url",
    "blur",
    "blurhash",
    "image",
    "image-loading",
    "placeholder",
    "ux",
    "visionary"
  ]
}
